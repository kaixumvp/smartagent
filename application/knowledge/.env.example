# Knowledge Hub — docker-compose 变量替换模板（复制为 .env；不要提交 .env）
# 在 application/knowledge/ 目录执行 `docker compose up` 时读取，用于替换
# docker-compose.yml 里的 ${EMBEDDER:-hash} 等占位符。

# ---- Embedding ----------------------------------------------------------
# "hash" = 依赖无关的确定性伪向量（默认，Demo/冒烟用）。
# "http" = OpenAI 兼容 /v1/embeddings，接真实语义向量。向量维度由后端启动时自动探测。
EMBEDDER=http
EMBEDDING_URL=https://your-embedding-endpoint/v1/embeddings
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=your-api-key
# EMBEDDING_DIM 在 EMBEDDER=http 下自动探测，无需填；hash 时可设 256

# ---- Reranker（可选，默认 lexical）--------------------------------------
# RERANKER_BACKEND=http
# RERANKER_URL=http://localhost:9090/rerank
# RERANKER_MODEL=bge-reranker

# Qdrant 由 compose 内网自动注入（QDRANT_URL=http://qdrant:6333），无需在此配置。
