# Knowledge Hub backend — environment reference (copy to .env; never commit .env)
# Every key maps 1:1 to a field on app.config.Settings (upper-cased).

# ---- Database -----------------------------------------------------------
# Local dev defaults to SQLite; docker-compose overrides with PostgreSQL.
# DATABASE_URL=sqlite:///./data/knowledge.db
# DATABASE_URL=postgresql+psycopg2://knowledge:knowledge@localhost:5432/knowledge
# AUTO_CREATE_TABLES=true

# ---- Object storage (originals + markdown) ------------------------------
# "local" → filesystem under OBJECT_STORE_DIR; "s3" → S3-compatible (MinIO).
OBJECT_STORE_TYPE=local
# OBJECT_STORE_DIR=./data/objects
# S3_ENDPOINT_URL=localhost:9010
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=knowledge
# S3_SECURE=false

# ---- Vector index -------------------------------------------------------
# Empty QDRANT_URL → in-memory index (dev/tests). Compose sets http://qdrant:6333.
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=knowledge_chunks

# ---- Embedding ----------------------------------------------------------
# "hash" = deterministic, dependency-free (no LLM needed, good for smoke tests).
# "http" = OpenAI-compatible /v1/embeddings; the vector dim is auto-detected on
#          startup, so EMBEDDING_DIM is not needed for http.
EMBEDDER=hash
# EMBEDDING_DIM=256            # only used when EMBEDDER=hash (http auto-detects)
# EMBEDDING_URL=https://your-embedding-endpoint/v1/embeddings
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=

# ---- OCR -----------------------------------------------------------------
# "none" (default) or "tesseract" (needs `poetry install --with ocr` + system tesseract).
OCR_BACKEND=none
# OCR_LANG=chi_sim+eng

# ---- Reranker ------------------------------------------------------------
# "lexical" = dependency-free overlap/quote rerank (default).
# "http" = cross-encoder endpoint (POST {model, query, documents} → {scores}).
RERANKER_BACKEND=lexical
# RERANKER_URL=http://localhost:9090/rerank
# RERANKER_MODEL=bge-reranker

# ---- Internal Retrieve API shared key ------------------------------------
# Empty = /internal/* is open (MVP/demo). Set a value and pass it as
# `X-Integration-Key` from the platform adapter.
# INTEGRATION_KEY=

# ---- Chunking / retrieval -------------------------------------------------
# MAX_CHUNK_CHARS=800
# CHUNK_OVERLAP=120
# SEARCH_CANDIDATE_MULTIPLIER=4
# RERANK_ENABLED=true
# CONTEXT_MAX_CHARS=6000

# ---- Ingest worker --------------------------------------------------------
# WORKER_ENABLED=true
# WORKER_INTERVAL_SECONDS=0.5
