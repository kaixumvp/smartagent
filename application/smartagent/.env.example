# Every field of smartagent.config.Settings can be set here (env var = field name, upper-cased).
# Commented-out lines show the default; uncomment only to change it.

# ===== App =====
DEBUG=false
# APP_NAME=smartagent
# API_PREFIX=/v1

# ===== Database (PostgreSQL + pgvector) =====
DATABASE_URL=postgresql+asyncpg://smartagent:smartagent@localhost:5432/smartagent

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM (DeepSeek, OpenAI-compatible) =====
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# LLM_API_BASE=                # Optional: custom API Base / proxy URL

# ===== Runtime defaults (an Agent's config.runtime overrides these per Agent) =====
MAX_ITERATIONS=20
TIMEOUT_SECONDS=120
MAX_SUBAGENT_DEPTH=3

# ===== Embedding (long-term memory; leave key empty to use the offline hash fallback) =====
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=
EMBEDDING_DIMENSION=1536

# ===== Memory =====
WORKING_MEMORY_WINDOW_SIZE=20
WORKING_MEMORY_TTL_SECONDS=86400
MEMORY_RECALL_TOP_K=5
CONSOLIDATION_SIMILARITY_THRESHOLD=0.85

# ===== Bootstrap =====
# Password for the `admin` account seeded by Alembic 0002. Read only at migration time, and
# only for a fresh database — re-running migrations never re-seeds it. Leave empty and the
# migration falls back to the well-known "admin123" with a warning; rotate it right away via
# POST /v1/auth/change-password.
BOOTSTRAP_ADMIN_PASSWORD=

# ===== Auth (JWT) =====
# AUTH_ENABLED=false returns a system *admin* principal for every request. That also disables the
# HITL approval path, because check_permission allows admins outright — so approval flows cannot be
# exercised locally with auth off.
AUTH_ENABLED=true
# HS256 needs at least 32 bytes (RFC 7518 §3.2) — the placeholder below is 23 and PyJWT warns
# about it. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_SECONDS=3600
# JWT_ALGORITHM=HS256

# ===== Rate limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=120

# ===== Judge (V1.1 evaluation) =====
# Scoring model, kept separate from the business model so scores are comparable and the judging
# cost is attributable on its own. It bypasses tiered routing and the prompt cache by design.
# Empty values fall back to LLM_MODEL / DEEPSEEK_API_KEY / LLM_API_BASE.
# JUDGE_MODEL=
# JUDGE_API_KEY=
# JUDGE_API_BASE=

# ===== Prompt cache (V1.1 cost) =====
# In-process memoization of (model, messages, tools). Hit rates are per worker, not global.
LLM_CACHE_ENABLED=false
LLM_CACHE_SIZE=256

# ===== Tiered model routing (V1.1 cost) =====
# Applies only to Agents that pinned no `config.model`; an Agent that set one always keeps it.
# Messages longer than the threshold (total characters) are treated as the expensive tier.
LLM_ROUTING_ENABLED=false
# LLM_CHEAP_MODEL=deepseek-chat
# LLM_EXPENSIVE_MODEL=gpt-4o
LLM_ROUTING_THRESHOLD=2000

# ===== Evaluation (V1.1) =====
# Cases in flight; each holds its own database session.
EVAL_CONCURRENCY=2
# Sweep evaluations stranded by a restart. Set to false where startup must not touch the database
# (the test suite does exactly that).
EVAL_SWEEP_ON_STARTUP=true

# ===== Token pricing (V1.1) =====
# JSON overriding the built-in table in smartagent/pricing.py: {"model": [input_per_1k, output_per_1k]}.
# A model with no price is billed as 0 and logged — an explicit gap beats a wrong number.
# MODEL_PRICES={"my-model": [0.001, 0.002]}
