# Repo-wide ignores. The per-project files under application/ still apply; this one covers
# the repo root and anything a project-level file misses.

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments / lock environments
.venv/
venv/
env/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node
node_modules/
.vite/
dist/
*.tsbuildinfo

# Local databases / vectors
*.db
*.sqlite
*.sqlite3

# Secrets and environment
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
